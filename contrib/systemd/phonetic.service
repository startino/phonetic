[Unit]
Description=Phonetic (user)
After=default.target graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=2
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=-@PROJECT_DIR@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/run/current-system/sw/bin/bash -lc 'if command -v nix >/dev/null 2>&1; then nix develop -c uv run phonetic --headless; else uv run phonetic --headless; fi'
KillMode=control-group

[Install]
WantedBy=default.target
