# phonetic — .env.example
# Copy this to .env in your config directory and set your key.
#
# This file holds ONLY secrets. The rest of the configuration lives in two
# sibling files in the same directory (Phonetic writes example versions of both
# on first run):
#   * settings.json  — app toggles: notify, verbose, auto_start, device.
#   * profiles.json  — per-hotkey transcription: each profile's own model,
#                      ASR/format models, system prompt, and hotkey. There is
#                      NO global MODEL or HOTKEY anymore — both live per-profile.
#
# Config directory:
#   macOS    ~/Library/Application Support/Phonetic/
#   Linux    ~/.config/phonetic/
#   Windows  %APPDATA%\Phonetic\

# Required: OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-...
