# phonetic configuration
# Copy this to .env and edit values as needed.
#
# WHAT LIVES WHERE:
#   * This file (config.env / .env) — global app settings + the single-call
#     transcription model. The keys below are the complete set Phonetic writes.
#   * profiles.json — per-hotkey transcription: each hotkey's own ASR model,
#     formatting model, and system prompt. That's where the two-stage pipeline
#     and multiple hotkeys are configured. See the "Per-keybind profiles"
#     section of the README and the auto-generated profiles.json.example.

# Required: OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Single-call transcription model + fallback formatting model (OpenRouter ID).
# Used when a profile leaves asr_model blank (single-call), and as the
# formatting-stage model when a two-stage profile leaves format_model blank.
MODEL=mistralai/voxtral-small-24b-2507

# Primary record-toggle hotkey (pynput format; on Wayland also supports SIGUSR1)
# macOS default: <cmd>+<shift>+r
HOTKEY=<ctrl>+<alt>+r

# Notifications: 1 to enable, 0 to disable
NOTIFY=1

# Auto-start at login: 1 to enable, 0 to disable
AUTO_START=0

# ----------------------------------------------------------------------------
# LEGACY keys (ASR_MODEL / FORMAT_MODEL / SYSTEM_PROMPT)
#   These are per-profile settings now and belong in profiles.json. They are
#   still HONORED here for backward compatibility: on first run, an existing
#   .env value seeds the synthesized default profile. But once profiles.json
#   exists (always, after first run), the profile's values win — editing these
#   afterward has no effect. Phonetic no longer writes them to config.env.
#   Prefer setting them per-hotkey in profiles.json.
# ----------------------------------------------------------------------------
# ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3
# FORMAT_MODEL=mistralai/mistral-small-3.2-24b-instruct
# SYSTEM_PROMPT="Transcribe verbatim. Output only the transcription."
