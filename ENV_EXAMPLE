# simple-whisper configuration example
# Copy this to .env and edit values as needed.

# Provider for Whisper transcription: 'openai' or 'azure'
WHISPER_PROVIDER=openai

# Hotkey label (effective on X11; on Wayland create a WM keybinding that sends SIGUSR1)
HOTKEY=<ctrl>+<alt>+r

# Audio settings
SAMPLE_RATE=16000
CHANNELS=1

# Notifications (Linux): 1 to enable, 0 to disable
NOTIFY=1

# Optional prompt to bias Whisper vocabulary/grammar
# See: https://cookbook.openai.com/examples/whisper_prompting_guide
# WHISPER_PROMPT="Use American English; terms: Kubernetes, Nix, Wayland"

# --- OpenAI Whisper ---
# Set if WHISPER_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Azure OpenAI Whisper ---
# Set if WHISPER_PROVIDER=azure
# You can set a base resource URL OR paste a full Target URI from Azure Studio.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=whisper
# AZURE_OPENAI_API_VERSION=2024-06-01
# Task: transcriptions (default) or translations
# AZURE_OPENAI_TASK=transcriptions

# --- Post-process (optional) ---
# If unset, POSTPROCESS_PROVIDER defaults to WHISPER_PROVIDER.
# For OpenAI, API key defaults to OPENAI_API_KEY.
# For Azure, endpoint/key/deployment/version default to AZURE_OPENAI_*.
# Enable by providing at least PROVIDER, MODEL (OpenAI) or DEPLOYMENT (Azure), and INSTRUCTION.
# The app first copies raw Whisper transcript, then overwrites with post-processed text when ready.

# POSTPROCESS_PROVIDER=openai
# POSTPROCESS_MODEL=gpt-5-nano
# POSTPROCESS_INSTRUCTION="Rewrite concisely in bullet points; fix grammar; keep meaning."
# POSTPROCESS_OPENAI_API_KEY=sk-...

# POSTPROCESS_PROVIDER=azure
# POSTPROCESS_AZURE_ENDPOINT=https://<resource>.openai.azure.com
# POSTPROCESS_AZURE_API_KEY=...
# POSTPROCESS_AZURE_DEPLOYMENT=<chat-deployment>
# POSTPROCESS_AZURE_API_VERSION=2024-06-01